// PostgreSQL (Railway in prod). Tables are created by `prisma db push` in the
// start script, so a fresh database provisions itself on first deploy.
// For local dev, point DATABASE_URL at a Postgres instance (e.g. Railway's
// DATABASE_PUBLIC_URL) rather than a sqlite file.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // Which skill unlock triggered the signup, for attribution.
  source        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// User-submitted entries for the public Slop Index. The score is computed at
// render from `copy` (never stored), so the detector stays the single source of
// truth. Curated seed entries live in code (lib/slop-index.ts); these merge in.
model SlopEntry {
  id        String   @id @default(cuid())
  name      String // brand / subject
  note      String? // category tag
  sourceUrl String?
  copy      String // the marketing copy that gets graded
  userId    String? // who submitted it (signed-in only)
  createdAt DateTime @default(now())

  @@index([createdAt])
}
