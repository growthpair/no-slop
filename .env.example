# --- Database -------------------------------------------------------------
# PostgreSQL. On Railway, reference the DB: ${{Postgres.DATABASE_URL}}.
# For local dev, use Railway's DATABASE_PUBLIC_URL (or any local Postgres).
DATABASE_URL="postgresql://user:pass@host:5432/dbname"

# --- NextAuth -------------------------------------------------------------
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# --- Google OAuth ---------------------------------------------------------
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Newsletter provider (optional) --------------------------------------
# On sign-up, the new user's email is pushed to whichever of these is set.
# Substack has no public write API, so use an ESP that feeds Substack.
# Beehiiv: https://developers.beehiiv.com
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=
# ConvertKit / Kit: https://developers.kit.com
CONVERTKIT_API_KEY=
CONVERTKIT_FORM_ID=

# --- Site -----------------------------------------------------------------
# Canonical URL, used for metadata / OG tags. Set to your real domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
